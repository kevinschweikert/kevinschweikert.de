{
  "name": "kevinschweikert.de",
  "version": "1.0.0",
  "description": "The source code for my personal blog at [kevinschweikert.de](https://kevinschweikert.de)",
  "author": "Kevin Schweikert",
  "devDependencies": {
    "@catppuccin/tailwindcss": "^1.0.0",
    "@fontsource/maple-mono": "^5.3.0",
    "@fontsource/sen": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.19",
    "tailwindcss": "^4.3.3"
  },
  "scripts": {
    "fonts:dir": "mkdir -p assets/fonts",
    "fonts:sen:400": "cp node_modules/@fontsource/sen/files/sen-latin-400-normal.woff2 assets/fonts/",
    "fonts:sen:600": "cp node_modules/@fontsource/sen/files/sen-latin-600-normal.woff2 assets/fonts/",
    "fonts:sen:700": "cp node_modules/@fontsource/sen/files/sen-latin-700-normal.woff2 assets/fonts/",
    "fonts:sen:800": "cp node_modules/@fontsource/sen/files/sen-latin-800-normal.woff2 assets/fonts/",
    "fonts:maple-mono:400": "cp node_modules/@fontsource/maple-mono/files/maple-mono-latin-400-normal.woff2 assets/fonts/",
    "copy-sen": "npm run fonts:sen:400 && npm run fonts:sen:600 && npm run fonts:sen:700 && npm run fonts:sen:800",
    "copy-maple-mono": "npm run fonts:maple-mono:400",
    "copy-fonts": "npm run fonts:dir && npm run copy-sen && npm run copy-maple-mono",
    "build": "tailwindcss -i assets/app.css -o assets/style.css",
    "build:prod": "tailwindcss -i assets/app.css -o assets/style.css --minify"
  }
}
